# Application Configuration
APP_NAME=Behavioral Optimization Platform
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Supabase default: shared session pooler (port 5432), copied from the Dashboard.
# Direct IPv6 alternative:
# postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Local SQLite alternative: sqlite+aiosqlite:///./habit_os.db
# Never commit real credentials; the real URL belongs in gitignored .env only.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
# Set True only for the shared transaction pooler (port 6543). This disables
# asyncpg prepared-statement caching for that mode.
DATABASE_DISABLE_PREPARED_STATEMENTS=False

# Supabase REST proof values (use the anon key, never a service_role key)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[SUPABASE-ANON-KEY]
SMOKE_API_URL=http://localhost:8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Optimization Engine
OPTIMIZATION_SOLVER=linear
OPTIMIZATION_TIMEOUT_SECONDS=30
OPTIMIZATION_TIME_PERIODS=7
OPTIMIZATION_MIN_SCHEDULE_DURATION=15

# AI/MCP Integration
MCP_SERVER_ENABLED=False
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Helper model split is unchanged: draft uses FAST, FAST, STRONG in that order.
NVIDIA_MODEL_FAST=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Testing
TESTING=False
